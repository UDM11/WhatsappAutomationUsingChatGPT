# WhatsApp Business API Configuration (Meta Developer)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_API_VERSION=v18.0

# Server Configuration
PORT=3000
NODE_ENV=production
# MUST be your public HTTPS URL (WhatsApp needs it to display generated images)
# e.g. https://yourdomain.com or https://your-ngrok-url.ngrok.io
BASE_URL=https://yourdomain.com

# ChatGPT Web Configuration (chatgpt.com)
CHATGPT_SESSION_TOKEN=your_session_token
CHATGPT_CF_CLEARANCE=your_cf_clearance_cookie

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Webhook Security
WEBHOOK_SECRET=your_webhook_secret_here

# Logging
LOG_LEVEL=info
